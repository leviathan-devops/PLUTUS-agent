{
  "name": "plutus-ts",
  "version": "2.0.0",
  "description": "Plutus Trading Engine v2.0 — Report-First Autonomous Trading Agent implementing TTE v5.3.3",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --bundle",
    "typecheck": "tsc --noEmit",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "clean": "rm -rf dist .plutus"
  },
  "keywords": [
    "plutus",
    "trident",
    "trading",
    "fx",
    "autonomous",
    "opencode",
    "shark-fork",
    "timesfm"
  ],
  "author": "Leviathan DevOps",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opencode-ai/plugin": "latest",
    "better-sqlite3": "^11.0.0",
    "chromium-bidi": "^12.0.0",
    "effect": "^4.0.0-beta.74",
    "ioredis": "^5.4.0",
    "xstate": "^5.13.0",
    "zeromq": "^6.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "bun-types": "^1.1.0"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "opencode-ai": ">=1.14.34"
  }
}
