{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-zen/mimo-v2.5-free",
  "provider": {
    "opencode-zen": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": ""
      },
      "models": {
        "mimo-v2.5-free": {
          "name": "MiMo V2.5 Free"
        },
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash Free"
        },
        "nemotron-3-super-free": {
          "name": "Nemotron 3 Super Free"
        }
      }
    }
  },
  "agent": {
    "plutus": {
      "name": "plutus",
      "description": "PLUTUS TTE v4.1 — Autonomous 3-engine trading intelligence. Generates A+ weekly TTE v5.3.3 trading reports for DXY, EUR/USD, GBP/USD, AUD/USD. Pipeline tools: harvest, zones, shapes, charts, setups.",
      "mode": "primary",
      "color": "#FF9800",
      "model": "opencode-zen/mimo-v2.5-free",
      "tools": {
        "plutus-pipeline-harvest": true,
        "plutus-pipeline-zones": true,
        "plutus-pipeline-shapes": true,
        "plutus-pipeline-charts": true,
        "plutus-pipeline-setups": true,
        "plutus-browse-screenshot": true,
        "plutus-backtest-setups": true,
        "plutus-status": true,
        "plutus-omni-vision": true,
        "read": true,
        "write": true,
        "glob": true,
        "grep": true,
        "webfetch": true
      }
    }
  },
  "plugin": [
    "file:///root/.config/opencode/plugins/plutus-engine/dist/index.js"
  ],
  "permission": { "*": { "*": "allow" } },
  "autoupdate": false
}
